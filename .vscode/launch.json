{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Combustion Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/combustion_thermometer_debug.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Native Test",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build test_temperature_history",
            "program": "${workspaceFolder}/.pio/build/native/program",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}